{
  "mcpServers": {
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "patrol": {
      "command": "./.claude/run-patrol",
      "env": {
        "PROJECT_ROOT": "./packages/testeador_base/example/pokebattle_rest",
        "PATROL_FLAGS": "",
        "SHOW_TERMINAL": "false"
      }
    },
    "serverpod": {
      "command": "serverpod_mcp",
      "args": []
    },
    "testeador": {
      "command": "dart",
      "args": [
        "run",
        "--no-serve-devtools",
        "packages/testeador_base/bin/testeador.dart",
        "mcp"
      ],
      "env": {
        "TESTEADOR_PROJECT_ROOT": "packages/testeador_base",
        "TESTEADOR_MCP_ENABLE_MULTIDEV": "1"
      }
    }
  }
}
